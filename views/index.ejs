<!DOCTYPE html>
<html>
<head>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <h2>Employees</h2>
    <a href="/add" class="btn">Add Employee</a>
    <table>
        <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Basic Salary</th>
        <th>Action</th>
        <th>Delete Record</th>
        </tr>
<% employees.forEach(emp => { %>
<tr>
<td><%= emp.name %></td>
<td><%= emp.email %></td>
<td>₹<%= emp.basic_salary %></td>
<td><a href="/generate/<%= emp.id %>" class="btn">Generate Payslip</a></td>
<td>
    <a href="/delete/<%= emp.id %>" class="btn danger">Delete</a>
</td>
</tr>
<% }) %>
</table>
</div>
</body>
</html>